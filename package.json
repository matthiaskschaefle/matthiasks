{
  "name": "matthias-portfolio",
  "description": "Portfolio website for Matthias Schaefle, UX/UI Designer in Berlin.",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "images:check": "node scripts/image-manifest.mjs --check",
    "verify": "npm run lint && npm run format:check && npm run images:check && npm run build && npm test && npm run smoke"
  },
  "dependencies": {
    "framer-motion": "^12.36.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.8",
    "prettier": "^3.9.10",
    "vite": "^7.3.1"
  }
}
